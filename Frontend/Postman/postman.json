        {
          "name": "Add Payment Method",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const methods = res.paymentMethods || (res.user && res.user.paymentMethods) || (Array.isArray(res) ? res : []);",
                  "if (res._id) {",
                  "    pm.collectionVariables.set('paymentMethodId', res._id);",
                  "} else if (methods.length) {",
                  "    pm.collectionVariables.set('paymentMethodId', methods[methods.length - 1]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardType\": \"Visa\",\n  \"last4\": \"4242\",\n  \"expiry\": \"12/28\",\n  \"cardHolderName\": \"Frontend Tester\",\n  \"billingAddress\": \"123 MG Road, Bangalore\"\n}"
