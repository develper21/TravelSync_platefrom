        {
          "name": "Create Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const pay = res.payment || res;",
                  "if (pm.response.code < 300 && pay._id) {",
                  "    pm.collectionVariables.set('paymentId', pay._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"tripId\": \"{{tripId}}\",\n  \"amount\": 25000,\n  \"currency\": \"INR\",\n  \"paymentMethod\": \"card\",\n  \"status\": \"completed\",\n  \"description\": \"Hotel booking payment\"\n}"
            },
