{
  "info": {
    "_postman_id": "a1b2c3d4-0002-4000-8000-000000000002",
    "name": "TravelSync Frontend API",
    "description": "TravelSync Frontend API collection — frontend app jo requests bhejta hai wahi sab yahan cover hai.\n\n## Import\nPostman → Import → select this file.\n\n## Setup\n1. Backend start karo: `cd server && npm run dev`\n2. Frontend bhi start karo: `cd Frontend && npm run dev` (optional — parallel testing ke liye)\n3. **1. Auth Flow → Sign In** chalao — token auto-save ho jayega, baaki requests `{{token}}` use karengi.\n\n## Ordering\nFolders user journey ke order me hain — upar se neeche chalao to poora frontend flow test ho jayega:\nAuth → Profile → Discover → Trip Planning → Bookings & Payments → Engagement.\n\n## Base URL\n`http://localhost:5000/api` — frontend ka `src/services/api.js` bhi yahi use karta hai. Deployed API pe test karna ho to `apiBaseUrl` variable change kar do.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiBaseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "tripId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "destinationId", "value": "" },
    { "key": "blogId", "value": "" },
    { "key": "hotelId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Auth Flow",
      "description": "User journey ka start — signup/signin karo, token apne aap save hoga.",
      "item": [
        {
          "name": "Signup New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.collectionVariables.set('userId', res.user ? res.user._id : '');",
                  "    console.log('Signup done — token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Frontend Tester\",\n  \"email\": \"frontend.test@example.com\",\n  \"password\": \"test123456\"\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/auth/signup",
              "host": ["{{apiBaseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "SignUp page yahi call karta hai. Response me token + 2FA QR code."
          },
          "response": []
        },
        {
          "name": "Sign In (existing user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 200 && res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.collectionVariables.set('userId', res.user ? res.user._id : '');",
                  "    console.log('Signed in as:', res.user ? res.user.email : 'unknown');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"frontend.test@example.com\",\n  \"password\": \"test123456\"\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/auth/signin",
              "host": ["{{apiBaseUrl}}"],
              "path": ["auth", "signin"]
            },
            "description": "SignIn page yahi call karta hai (localStorage me token save hota hai — yahan collection variable me)."
          },
          "response": []
        },
