{
  "info": {
    "_postman_id": "a1b2c3d4-0001-4000-8000-000000000001",
    "name": "TravelSync Backend API",
    "description": "TravelSync Backend API collection for local development testing.\n\n## Import\nPostman → Import → select this file.\n\n## Setup\n1. Server start karo: `cd server && npm run dev` (default port 5000).\n2. **Auth → Sign In** chalao — token, userId, tripId etc. collection variables me auto-save ho jayenge.\n3. Protected routes automatically `{{token}}` use karenge.\n\n## Base URL\n- Local: `http://localhost:5000` (default)\n- Deployed: collection variable `baseUrl` change kar do\n\n## Auth\nJWT Bearer token — Sign In response se auto-captured hota hai (7 din valid).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "tripId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "destinationId", "value": "" },
    { "key": "blogId", "value": "" },
    { "key": "hotelId", "value": "" },
    { "key": "paymentMethodId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
