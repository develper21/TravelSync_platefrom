          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.collectionVariables.set('userId', res.user ? res.user._id : '');",
                  "    console.log('Token auto-saved. QR code (2FA):', res.qrCode ? 'received' : 'none');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
