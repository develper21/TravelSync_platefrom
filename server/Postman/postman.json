        {
          "name": "Add Payment Method",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code < 300 && res._id) {",
                  "    pm.collectionVariables.set('paymentMethodId', res._id);",
                  "} else if (pm.response.code < 300) {",
                  "    // Some responses return the full user with paymentMethods array",
                  "    const methods = res.paymentMethods || (res.user && res.user.paymentMethods);",
                  "    if (methods && methods.length) {",
                  "        pm.collectionVariables.set('paymentMethodId', methods[methods.length - 1]._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
